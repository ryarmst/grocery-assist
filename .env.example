# Copy to .env and fill in the three required values. .env is gitignored.

# --- Required ------------------------------------------------------------------------------

# Public API key the No Frills website sends as `x-apikey` to api.pcexpress.ca (the same for every
# visitor, not a personal secret). Find it in your browser: DevTools → Network → any request to
# api.pcexpress.ca → Request headers → x-apikey.
PCX_API_KEY=

# The URL you'll open the app at. Used in review links the agent hands you, and its hostname is
# automatically allowed (DNS-rebinding protection). Examples: http://192.168.1.50:8000, https://grocery.example.com
PUBLIC_URL=http://localhost:8000

# Shared secret for the MCP endpoint. Agents must send `Authorization: Bearer <MCP_TOKEN>`.
# Generate one with:  openssl rand -hex 32
MCP_TOKEN=

# --- Optional ------------------------------------------------------------------------------

# No Frills store for prices and the cart (3728 = Rob & Rachael's NOFRILLS London).
STORE_ID=3728

# How often (hours) to rescan every aisle's deals in the background (about 200 requests, ~3 min). 0 = off.
# DEAL_SCAN_HOURS=24

# Docker port publishing: host address and port.
# BIND_ADDR=0.0.0.0
# HOST_PORT=8000

# Extra hostnames/IPs the app should answer to besides PUBLIC_URL's host (comma-separated).
# ALLOWED_HOSTS=

# Running without Docker: where data lives and which addresses to listen on (comma-separated).
# DATA_DIR=./data
# HOST=127.0.0.1

LOG_LEVEL=INFO
