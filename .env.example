# Copy to .env and fill in. .env is gitignored.

# Public API key the No Frills website sends as the `x-apikey` header to api.pcexpress.ca.
# Find it in your browser: DevTools → Network → any request to api.pcexpress.ca → Request
# headers → x-apikey. It is the same for every visitor (not a personal secret), but keep it
# out of git anyway.
PCX_API_KEY=

# No Frills store id used for prices and the cart (3728 = Rob & Rachael's NOFRILLS London).
STORE_ID=3728
BANNER=nofrills

# Where the SQLite database and session token live (Docker overrides this to /data).
DATA_DIR=./data

# Web/MCP server bind address(es), comma-separated, e.g. 127.0.0.1,192.168.56.10 to also listen on a
# host-only adapter. Docker sets HOST=0.0.0.0 inside the container.
HOST=127.0.0.1
PORT=8000

# Base URL used in links handed to the agent (review_url etc).
PUBLIC_URL=http://localhost:8000

# Host names the server answers to (DNS-rebinding protection for MCP). Add your VM's
# hostname or IP if you access it remotely.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional shared secret for the MCP endpoint. When set, MCP clients must send
# `Authorization: Bearer <MCP_TOKEN>`. Strongly recommended if the port is exposed beyond localhost.
MCP_TOKEN=

LOG_LEVEL=INFO
